# ---------------------------------------------------------------------------
# Ragnar Capital · Agente de TikTok
# Copia este archivo como  .env  y completa los valores.
# NUNCA subas el archivo .env a ningún repositorio ni lo pegues en un chat.
# ---------------------------------------------------------------------------

# --- IA (Claude / Anthropic) ------------------------------------------------
# Crear en: https://console.anthropic.com  ->  Settings -> API keys
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZAR

# Modelo a usar. Por defecto el más capaz.
# Si el volumen de mensajes crece y quieres bajar el costo, puedes cambiarlo
# a  claude-sonnet-5  sin tocar el código.
ANTHROPIC_MODEL=claude-opus-5

# --- TikTok -----------------------------------------------------------------
# El usuario es sólo para etiquetar la sesión en los logs.
# La CONTRASEÑA NO se guarda aquí: el login se hace una sola vez de forma
# manual con  `python -m ragnar_agent.cli.login`  y se guarda la sesión.
TIKTOK_USERNAME=ragnarcapital

# Carpeta donde se guarda la sesión del navegador (cookies). Trátala como
# si fuera una contraseña.
TIKTOK_PROFILE_DIR=.session/tiktok

# --- Odoo (opcional) --------------------------------------------------------
# Sólo si se decide leer las tasas desde Odoo en vez del Google Sheet.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# --- Operación --------------------------------------------------------------
# true  = no envía nada, sólo escribe en consola lo que enviaría (modo seguro)
# false = envía de verdad
DRY_RUN=true

LOG_LEVEL=INFO
