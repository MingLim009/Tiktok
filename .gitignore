# API keys
.env
.env.*
!.env.example

# Sesión de TikTok: equivale a la contraseña de la cuenta
.session/

# Conversaciones y datos personales de clientes
*.sqlite3
*.db

# Paquetes de entrega (se regeneran con el script de empaquetado)
client/

# Diagnósticos y capturas: pueden mostrar datos de clientes
diagnostico_bandeja.html
diagnostico_bandeja.txt
*.png
*.jpg
*.jpeg

# ---------------------------------------------------------------------------
#  Temporales
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
logs/
probar_check.cmd

.vscode/
.idea/
.DS_Store
Thumbs.db
